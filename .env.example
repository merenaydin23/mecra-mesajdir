# ==========================================
# Mecra Mesajdır - Ortam Değişkenleri Şablonu
# ==========================================
# LLM_MODE: external (Gemini) | internal (kurumsal LLM)

LLM_MODE=external

# --- Kurum dışı: Google Gemini (OpenAI-uyumlu endpoint) ---
GEMINI_API_KEY=buraya_gemini_api_key_yazin
EXTERNAL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EXTERNAL_LLM_MODEL_NAME=gemini-2.5-flash

# --- Kurum içi: Kurumsal OpenAI-uyumlu LLM ---
INTERNAL_LLM_API_KEY=buraya_kurumsal_api_key_yazin
INTERNAL_LLM_BASE_URL=https://llmstat.iletisim.gov.tr/v1
INTERNAL_LLM_MODEL_NAME=qwen-397b

# --- MSSQL (auto | true | false) ---
MSSQL_ENABLED=auto
MSSQL_DRIVER={SQL Server}
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=Mecra_Mesajdır_DB
MSSQL_TRUSTED_CONNECTION=yes
